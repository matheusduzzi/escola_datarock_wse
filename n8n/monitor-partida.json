{
  "name": "Monitor de preços: ponto de partida",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "0e5e0001-0000-4000-8000-000000000001",
      "name": "Todo dia às 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "0e5e0001-0000-4000-8000-000000000002",
      "name": "Rodar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://books.toscrape.com/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "curso-web-scraping-em-escala (estudo)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "0e5e0001-0000-4000-8000-000000000003",
      "name": "Baixar a página 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "titulo",
              "cssSelector": "article.product_pod h3 a",
              "returnValue": "attribute",
              "attribute": "title",
              "returnArray": true
            },
            {
              "key": "preco",
              "cssSelector": "article.product_pod p.price_color",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "id": "0e5e0001-0000-4000-8000-000000000004",
      "name": "Tirar título e preço",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        480,
        100
      ]
    }
  ],
  "connections": {
